PGUSER=certsvc
PGPASSWORD=replace_me_with_a_strong_database_password
PGDATABASE=certsvc
DATABASE_URL=postgresql://certsvc:replace_me_with_a_strong_database_password@di-postgres:5432/certsvc?schema=public

JWT_SECRET=replace_me_with_a_long_random_jwt_secret
JWT_EXPIRES_IN=24h

AUTH_USERNAME=admin
AUTH_PASSWORD=replace_me_with_a_strong_initial_admin_password

FOUR_EYES_ADMIN_OVERRIDE=false

HSM_TOKEN_LABEL=econet-ca
HSM_SO_PIN=replace_me_with_a_strong_so_pin
HSM_USER_PIN=replace_me_with_a_strong_user_pin

# Externally reachable base URL of this API. Written into every issued
# certificate as the CRL distribution point and caIssuers pointer, so relying
# parties can check revocation. Change it and previously-issued certificates
# keep pointing at the old address.
PKI_BASE_URL=http://localhost:8080
# Set only when an OCSP responder is actually deployed; otherwise no OCSP URL
# is published (better than advertising a responder that does not answer).
# PKI_OCSP_URL=http://localhost:2560

# Where the QR code printed on a stamped document sends the person scanning it.
PUBLIC_VERIFY_BASE_URL=http://localhost:8080

# Certificate expiry surveillance: warn this far ahead, sweeping this often.
# Set CERT_EXPIRY_SWEEP_HOURS=0 to disable the sweep.
CERT_EXPIRY_WARNING_DAYS=30
CERT_EXPIRY_SWEEP_HOURS=24
